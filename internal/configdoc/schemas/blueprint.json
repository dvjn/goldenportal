{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blueprint",
  "description": "A blueprint defines a kind of catalog entity, such as service or team: the properties its entities have, including relations to other entities, and the tabs of widgets its catalog and entity pages add.",
  "type": "object",
  "properties": {
    "kind": { "const": "Blueprint" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "required": ["kind", "metadata", "spec"],
  "additionalProperties": false,
  "$defs": {
    "spec": {
      "type": "object",
      "properties": {
        "properties": {
          "type": "object",
          "description": "The entities' properties, keyed by name, in the order the catalog shows them. Every entity also has the built-in fields identifier, title, blueprint, connection, createdAt and updatedAt.",
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,62}$",
            "not": { "enum": ["identifier", "title", "blueprint", "connection", "createdAt", "updatedAt"] }
          },
          "additionalProperties": { "$ref": "#/$defs/property" }
        },
        "catalog": { "$ref": "#/$defs/catalog" },
        "entity": { "$ref": "#/$defs/entity" },
        "retention": { "$ref": "#/$defs/retention" },
        "sources": {
          "type": "array",
          "description": "Where the blueprint's entities come from: each source turns the items of one resource of a connection into its entities. Every expression is jq over an item.",
          "items": { "$ref": "#/$defs/source" }
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "description": "Turns the items of one resource of a connection into entities of this blueprint. Every expression is jq over an item.",
      "properties": {
        "connection": {
          "$ref": "#/$defs/identifier",
          "description": "The connection whose items it reads."
        },
        "resource": {
          "type": "string",
          "description": "The resource whose items it maps: one of the connection's connector's resources, or for http, a key of config.resources."
        },
        "filter": {
          "$ref": "#/$defs/jq",
          "description": "jq over each item; keeps the items it's true for. Deleted items skip it."
        },
        "mode": {
          "enum": ["reconcile", "upsert"],
          "description": "reconcile, the default, makes the blueprint hold what the resource holds: a complete sync reads it in full and deletes the entities it no longer has. upsert writes what's new or changed since the last sync and deletes only what an item says was deleted, so rows go only by the blueprint's retention; a blueprint with retention takes only upsert sources. A blueprint's sources from one connection share a mode."
        },
        "entity": { "$ref": "#/$defs/sourceEntity" }
      },
      "required": ["connection", "resource", "entity"],
      "examples": [
        {
          "connection": "gitlab",
          "resource": "groups",
          "entity": {
            "identifier": ".full_path",
            "title": ".name",
            "properties": {
              "description": ".description",
              "parent": ".full_path | split(\"/\") | .[:-1] | join(\"/\") | select(. != \"\")",
              "url": ".web_url"
            }
          }
        },
        {
          "connection": "gitlab",
          "resource": "projects",
          "filter": ".marked_for_deletion_on == null and .empty_repo != true",
          "entity": {
            "identifier": ".path_with_namespace",
            "title": ".name",
            "properties": {
              "service": ".path",
              "description": ".description",
              "visibility": ".visibility",
              "defaultBranch": ".default_branch",
              "archived": ".archived",
              "stars": ".star_count",
              "topics": ".topics",
              "url": ".web_url",
              "lastActivityAt": ".last_activity_at",
              "ci": "._gp.latestPipeline.status",
              "ciValid": "._gp.ciConfig.valid",
              "ciStages": "[._gp.ciConfig.jobs[]?.stage] | unique",
              "defaultBranchProtected": "._gp.defaultBranch.protected"
            }
          }
        },
        {
          "connection": "gitlab",
          "resource": "tags",
          "entity": {
            "identifier": "._gp.project + \"@\" + .name",
            "title": ".name",
            "properties": {
              "repo": "._gp.project",
              "commit": ".commit.short_id"
            }
          }
        },
        {
          "connection": "gitlab",
          "resource": "merge_requests",
          "entity": {
            "identifier": "._gp.project + \"!\" + (.iid | tostring)",
            "title": ".title",
            "properties": {
              "repo": "._gp.project",
              "state": "if .state == \"opened\" and .draft then \"draft\" else .state end",
              "author": ".author.username",
              "branch": ".source_branch",
              "url": ".web_url",
              "openedAt": ".created_at",
              "lastActivityAt": ".updated_at"
            }
          }
        },
        {
          "connection": "gitlab",
          "resource": "issues",
          "entity": {
            "identifier": "._gp.project + \"#\" + (.iid | tostring)",
            "title": ".title",
            "properties": {
              "repo": "._gp.project",
              "state": ".state",
              "author": ".author.username",
              "labels": ".labels",
              "url": ".web_url"
            }
          }
        },
        {
          "connection": "gitlab",
          "resource": "releases",
          "entity": {
            "identifier": "._gp.project + \"@\" + .tag_name",
            "title": ".name // .tag_name",
            "properties": {
              "repo": "._gp.project",
              "tag": ".tag_name",
              "upcoming": ".upcoming_release",
              "releasedAt": ".released_at",
              "url": "._links.self"
            }
          }
        },
        {
          "connection": "gitlab",
          "resource": "pipelines",
          "entity": {
            "identifier": ".id",
            "title": "._gp.project + \" \" + .ref",
            "properties": {
              "repo": "._gp.project",
              "ref": ".ref",
              "source": ".source",
              "status": ".status",
              "url": ".web_url",
              "triggeredAt": ".created_at"
            }
          }
        },
        {
          "connection": "gitlab",
          "resource": "jobs",
          "mode": "upsert",
          "entity": {
            "identifier": "(.pipeline.id | tostring) + \":\" + .name",
            "title": ".name",
            "properties": {
              "pipeline": ".pipeline.id | tostring",
              "repo": "._gp.project",
              "name": ".name",
              "stage": ".stage",
              "status": ".status",
              "attempts": "._gp.attempts",
              "failedAttempts": "._gp.failedAttempts",
              "flaky": "._gp.flaky",
              "seconds": ".duration",
              "waitSeconds": "._gp.waitSeconds",
              "url": ".web_url"
            }
          }
        },
        {
          "connection": "gitlab",
          "resource": "job_attempts",
          "mode": "upsert",
          "entity": {
            "identifier": ".id",
            "title": ".name + \" #\" + (._gp.attempt | tostring)",
            "properties": {
              "pipeline": ".pipeline.id | tostring",
              "repo": "._gp.project",
              "runner": ".runner.id | values | tostring",
              "status": ".status",
              "failureReason": ".failure_reason",
              "attempt": "._gp.attempt",
              "retried": "._gp.retried",
              "seconds": ".duration",
              "queuedSeconds": ".queued_duration",
              "waitSeconds": "._gp.waitSeconds",
              "playWaitSeconds": "._gp.playWaitSeconds",
              "manual": "._gp.manual",
              "playedBy": "._gp.playedBy.username",
              "startedAt": ".started_at",
              "url": ".web_url"
            }
          }
        },
        {
          "connection": "gitlab",
          "resource": "runners",
          "mode": "upsert",
          "entity": {
            "identifier": ".id",
            "title": "._gp.title",
            "properties": {
              "type": ".runner_type | rtrimstr(\"_type\")",
              "status": ".status",
              "tags": ".tag_list",
              "version": ".version",
              "groups": "._gp.groups",
              "repositories": "._gp.projects",
              "lastJobAt": "._gp.lastJobAt",
              "url": "._gp.url"
            }
          }
        },
        {
          "connection": "gitlab",
          "resource": "deployments",
          "entity": {
            "identifier": ".id",
            "title": "._gp.project + \" \" + .environment.name",
            "properties": {
              "repo": "._gp.project",
              "environment": ".environment.name",
              "version": ".sha[0:8]",
              "status": ".status",
              "startedAt": ".created_at",
              "finishedAt": ".finished_at",
              "approvalSeconds": "._gp.approvalSeconds"
            }
          }
        },
        {
          "connection": "gitlab",
          "resource": "environments",
          "entity": {
            "identifier": "._gp.project + \"/\" + .name",
            "title": ".name",
            "properties": {
              "repo": "._gp.project",
              "tier": ".tier",
              "state": ".state",
              "url": ".external_url",
              "version": "._gp.lastDeployment.sha[0:8]",
              "deployedAt": "._gp.lastDeployment.finished_at"
            }
          }
        },
        {
          "connection": "gitlab",
          "resource": "members",
          "filter": ".state == \"active\"",
          "entity": {
            "identifier": "._gp.group + \"/\" + .username",
            "title": ".name",
            "properties": {
              "group": "._gp.group",
              "username": ".username",
              "accessLevel": ".access_level"
            }
          }
        },
        {
          "connection": "sonarqube",
          "resource": "projects",
          "entity": {
            "identifier": ".key",
            "title": ".name",
            "properties": {
              "repo": "._gp.repository.url | select(. != null) | sub(\"^https?://[^/]+/\"; \"\")",
              "gate": "._gp.qualityGate.status",
              "coverage": "._gp.measures.coverage",
              "analysedAt": ".analysisDate"
            }
          }
        },
        {
          "connection": "authentik",
          "resource": "groups",
          "filter": ".attributes.goldenportal.team == true",
          "entity": {
            "identifier": ".name | ascii_downcase | gsub(\"[^a-z0-9]+\"; \"-\")",
            "title": ".name",
            "properties": {
              "members": "._gp.members"
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "sourceEntity": {
      "type": "object",
      "description": "Makes an entity from an item, with jq over the item. A deleted item only needs its identifier.",
      "properties": {
        "identifier": {
          "$ref": "#/$defs/jq",
          "description": "jq giving the entity's identifier, such as .id."
        },
        "title": {
          "$ref": "#/$defs/jq",
          "description": "jq giving the entity's title. Defaults to its identifier."
        },
        "properties": {
          "type": "object",
          "description": "jq giving each property's value, keyed by the blueprint's stored property or relation. A relation takes the identifier, or a list of them, of the related entities.",
          "additionalProperties": { "$ref": "#/$defs/jq" }
        }
      },
      "required": ["identifier"],
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "description": "Deletes rows once the date-time property by is older than keep, such as pipelines a month after they started. A scheduled job deletes them, daily unless the instance says otherwise. Rows whose by is empty, such as merge requests still open, are kept. Without retention, rows are kept for ever. Once published to keep rows longer, the next sync of each connection writing the blueprint reads back as far as the new keep. Every source must use mode: upsert.",
      "properties": {
        "by": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,62}$",
          "description": "The stored date-time property rows are kept by, such as startedAt or closedAt."
        },
        "keep": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,5}[smhdw]$",
          "description": "How long rows are kept, at least 1d, such as 30d or 52w."
        },
        "rules": {
          "type": "array",
          "description": "Keep the rows a filter matches longer, such as production deployments for a year. A row is kept for the longest keep of the rules it matches.",
          "items": { "$ref": "#/$defs/retentionRule" }
        }
      },
      "required": ["by", "keep"],
      "additionalProperties": false
    },
    "retentionRule": {
      "type": "object",
      "properties": {
        "filter": {
          "$ref": "#/$defs/filter",
          "description": "The rows to keep longer. It compares the row's own stored and computed properties and relations with eq, ne, in or exists, against values written here."
        },
        "keep": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,5}[smhdw]$",
          "description": "How long the rows it matches are kept, at least the blueprint's keep, such as 365d."
        }
      },
      "required": ["filter", "keep"],
      "additionalProperties": false
    },
    "property": {
      "description": "A value entities have. Connections write stored properties and relations; the portal works out lookups, computed properties and scorecard results. Which it is follows from its keys: relation, scorecard, lookup or compute, or otherwise stored.",
      "oneOf": [
        { "$ref": "#/$defs/storedProperty" },
        { "$ref": "#/$defs/relationProperty" },
        { "$ref": "#/$defs/scorecardProperty" },
        { "$ref": "#/$defs/lookupProperty" },
        { "$ref": "#/$defs/computedProperty" }
      ]
    },
    "propertyTitle": {
      "type": "string",
      "description": "The property's label. Defaults to its name."
    },
    "propertyDescription": {
      "type": "string",
      "description": "Help shown beside the property, saying what it holds."
    },
    "valueType": {
      "enum": ["string", "number", "integer", "boolean", "array", "object"],
      "description": "The JSON type of the values. Dates and URLs are strings with a format."
    },
    "format": {
      "enum": ["date", "date-time", "uri", "email", "markdown"],
      "description": "String values only: what the text is, which decides how it's checked and shown."
    },
    "enum": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "The only values allowed, of the property's type. String, number and integer properties only.",
      "items": { "type": ["string", "number"] }
    },
    "storedProperty": {
      "type": "object",
      "description": "A value connections write, checked against its type and constraints.",
      "properties": {
        "title": { "$ref": "#/$defs/propertyTitle" },
        "description": { "$ref": "#/$defs/propertyDescription" },
        "type": { "$ref": "#/$defs/valueType" },
        "format": { "$ref": "#/$defs/format" },
        "enum": { "$ref": "#/$defs/enum" },
        "required": { "type": "boolean", "description": "Connections must write a value." },
        "pattern": { "type": "string", "description": "String properties only: a regular expression (Go RE2 syntax) values must match." },
        "minLength": { "type": "integer", "minimum": 0, "description": "String properties only: the fewest characters." },
        "maxLength": { "type": "integer", "minimum": 0, "description": "String properties only: the most characters." },
        "minimum": { "type": "number", "description": "Number and integer properties only: the lowest value." },
        "maximum": { "type": "number", "description": "Number and integer properties only: the highest value." },
        "items": { "$ref": "#/$defs/items" },
        "display": { "$ref": "#/$defs/display" }
      },
      "required": ["type"],
      "allOf": [
        { "$ref": "#/$defs/typedValues" },
        { "$ref": "#/$defs/typedDisplay" },
        { "$ref": "#/$defs/typedUnit" },
        {
          "if": { "properties": { "type": { "const": "string" } } },
          "else": { "properties": { "pattern": false, "minLength": false, "maxLength": false } }
        },
        {
          "if": { "properties": { "type": { "enum": ["number", "integer"] } } },
          "else": { "properties": { "minimum": false, "maximum": false } }
        },
        {
          "if": { "properties": { "type": { "enum": ["array", "object", "boolean"] } } },
          "then": { "properties": { "enum": false } }
        }
      ],
      "additionalProperties": false
    },
    "relationProperty": {
      "type": "object",
      "description": "Identifiers of entities of another blueprint, which connections write. Paths follow it to the related entity's fields, such as owner.title.",
      "properties": {
        "title": { "$ref": "#/$defs/propertyTitle" },
        "description": { "$ref": "#/$defs/propertyDescription" },
        "relation": { "$ref": "#/$defs/identifier", "description": "The blueprint whose entities it points at." },
        "many": { "type": "boolean", "description": "Holds a list of identifiers rather than one." },
        "required": { "type": "boolean", "description": "Connections must write a value." },
        "display": {
          "$ref": "#/$defs/display",
          "properties": { "as": { "const": "link" }, "unit": false }
        }
      },
      "required": ["relation"],
      "additionalProperties": false
    },
    "scorecardProperty": {
      "type": "object",
      "description": "An entity's result on a scorecard, which the scorecard works out. A path naming it reads the tier reached, and follows it into score, counts and checks, such as readiness.checks.hasOwner.",
      "properties": {
        "title": { "$ref": "#/$defs/propertyTitle" },
        "description": { "$ref": "#/$defs/propertyDescription" },
        "type": { "const": "scorecard" },
        "scorecard": { "$ref": "#/$defs/identifier", "description": "The scorecard whose result it holds; it scores this blueprint." },
        "display": {
          "$ref": "#/$defs/display",
          "properties": { "as": { "const": "badge" }, "unit": false }
        }
      },
      "required": ["scorecard"],
      "additionalProperties": false
    },
    "lookupProperty": {
      "type": "object",
      "description": "A value read from a related entity, which the portal keeps up to date.",
      "properties": {
        "title": { "$ref": "#/$defs/propertyTitle" },
        "description": { "$ref": "#/$defs/propertyDescription" },
        "lookup": {
          "type": "string",
          "pattern": "^[^.$]+(\\.[^.$]+){1,3}$",
          "description": "A path following 1 to 3 relations and ending on a field, such as owner.slackChannel. No $."
        },
        "type": { "$ref": "#/$defs/valueType", "description": "Optional: it defaults to the looked-up field's." },
        "format": { "$ref": "#/$defs/format" },
        "items": { "$ref": "#/$defs/items" },
        "display": {
          "$ref": "#/$defs/display",
          "properties": {
            "as": { "enum": ["text", "badge", "code", "link", "date", "relative", "number", "progress", "check", "tags", "list"] },
            "filter": { "const": false }
          }
        }
      },
      "required": ["lookup"],
      "allOf": [
        { "$ref": "#/$defs/typedDisplay" },
        {
          "if": { "properties": { "type": { "const": "array" } }, "required": ["type"] },
          "else": { "properties": { "items": false } }
        },
        {
          "if": { "properties": { "type": { "const": "string" } } },
          "else": { "properties": { "format": false } }
        }
      ],
      "additionalProperties": false
    },
    "computedProperty": {
      "type": "object",
      "description": "A value worked out with jq from the entity's other fields.",
      "properties": {
        "title": { "$ref": "#/$defs/propertyTitle" },
        "description": { "$ref": "#/$defs/propertyDescription" },
        "compute": { "$ref": "#/$defs/jq", "description": "jq over the entity, such as .tier == \"critical\"." },
        "type": { "$ref": "#/$defs/valueType" },
        "format": { "$ref": "#/$defs/format" },
        "items": { "$ref": "#/$defs/items" },
        "display": { "$ref": "#/$defs/display" }
      },
      "required": ["compute", "type"],
      "allOf": [
        { "$ref": "#/$defs/typedDisplay" },
        { "$ref": "#/$defs/typedUnit" },
        {
          "if": { "properties": { "type": { "const": "array" } } },
          "else": { "properties": { "items": false } }
        },
        {
          "if": { "properties": { "type": { "const": "string" } } },
          "else": { "properties": { "format": false } }
        }
      ],
      "additionalProperties": false
    },
    "typedValues": {
      "description": "Ties format, items and enum values to the property's type.",
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "string" } } },
          "then": { "properties": { "enum": { "items": { "type": "string" } } } },
          "else": { "properties": { "format": false } }
        },
        {
          "if": { "properties": { "type": { "const": "number" } } },
          "then": { "properties": { "enum": { "items": { "type": "number" } } } }
        },
        {
          "if": { "properties": { "type": { "const": "integer" } } },
          "then": { "properties": { "enum": { "items": { "type": "integer" } } } }
        },
        {
          "if": { "properties": { "type": { "const": "array" } } },
          "else": { "properties": { "items": false } }
        }
      ]
    },
    "typedDisplay": {
      "description": "Ties display.as to the property's type.",
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "string" } }, "required": ["type"] },
          "then": { "properties": { "display": { "properties": { "as": { "enum": ["text", "badge", "code", "link", "date", "relative"] } } } } }
        },
        {
          "if": { "properties": { "type": { "enum": ["number", "integer"] } }, "required": ["type"] },
          "then": { "properties": { "display": { "properties": { "as": { "enum": ["number", "progress", "badge"] } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "boolean" } }, "required": ["type"] },
          "then": { "properties": { "display": { "properties": { "as": { "enum": ["check", "badge"] } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "array" } }, "required": ["type"] },
          "then": { "properties": { "display": { "properties": { "as": { "enum": ["tags", "list"] } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "object" } }, "required": ["type"] },
          "then": { "properties": { "display": { "properties": { "as": { "const": "json" }, "filter": { "const": false } } } } }
        }
      ]
    },
    "typedUnit": {
      "description": "Only numbers have a unit.",
      "if": { "properties": { "type": { "enum": ["number", "integer"] } } },
      "else": { "properties": { "display": { "properties": { "unit": false } } } }
    },
    "items": {
      "type": "object",
      "description": "Array properties only: what each value in the list is. Defaults to strings.",
      "properties": {
        "type": { "enum": ["string", "number", "integer", "boolean", "object"] },
        "format": { "$ref": "#/$defs/format" },
        "enum": { "$ref": "#/$defs/enum" }
      },
      "required": ["type"],
      "allOf": [
        { "$ref": "#/$defs/typedValues" },
        {
          "if": { "properties": { "type": { "enum": ["boolean", "object"] } } },
          "then": { "properties": { "enum": false } }
        }
      ],
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "description": "How the portal shows the property's values, in tables, on entity pages and in widgets. Every field is optional; the type picks the rest.",
      "properties": {
        "as": {
          "enum": ["text", "badge", "code", "link", "date", "relative", "number", "progress", "check", "tags", "list", "json"],
          "description": "How a value looks, from those its type allows: strings text (default), badge, code, link, date or relative; numbers number (default), progress or badge; booleans check (default) or badge; arrays tags (default) or list; objects json; relations link; scorecards badge. progress runs from the property's minimum to its maximum, or 0 to 100."
        },
        "unit": { "type": "string", "description": "Numbers only: follows the value, such as % or ms." },
        "colors": {
          "type": "object",
          "description": "Colors badges by value: each key is one of the property's values (one of its enum, if it has one).",
          "additionalProperties": { "$ref": "#/$defs/color" }
        },
        "titles": {
          "type": "object",
          "description": "Titles an enum value shown in place of its own text: each key is one of the property's values (one of its enum, if it has one). Without one, the value is shown in Title Case.",
          "additionalProperties": { "type": "string" }
        },
        "filter": { "type": "boolean", "description": "Offers the property's values as a catalog filter. Not for lookups or objects." },
        "hidden": { "type": "boolean", "description": "Leaves the property off entity pages; it's still in the data." },
        "empty": { "type": "string", "description": "Shown when an entity has no value, such as No owner." }
      },
      "additionalProperties": false
    },
    "catalog": {
      "type": "object",
      "description": "The blueprint's catalog page: its default columns, and tabs of widgets after the entities tab every catalog has.",
      "properties": {
        "columns": {
          "type": "array",
          "uniqueItems": true,
          "description": "The catalog table's default columns after the title column: property names, connection, createdAt or updatedAt.",
          "items": {
            "type": "string",
            "not": { "enum": ["identifier", "title", "blueprint"] }
          }
        },
        "queries": { "$ref": "#/$defs/queries" },
        "tabs": {
          "$ref": "#/$defs/tabs",
          "propertyNames": { "not": { "const": "entities" } },
          "additionalProperties": {
            "properties": {
              "when": false,
              "widgets": {
                "additionalProperties": {
                  "not": { "properties": { "type": { "const": "properties" } }, "required": ["type"] }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "description": "The pages of the blueprint's entities: what shows beside the title, how the overview groups properties, and tabs of widgets after the relations and yaml tabs every entity page has. A tab named overview replaces the built-in one. Filters and jq here can use $entity, the page's entity.",
      "properties": {
        "header": { "$ref": "#/$defs/header" },
        "sections": {
          "type": "array",
          "description": "Groups of properties on the overview, in order. Properties no section lists follow them.",
          "items": { "$ref": "#/$defs/section" }
        },
        "queries": { "$ref": "#/$defs/queries" },
        "tabs": {
          "$ref": "#/$defs/tabs",
          "propertyNames": { "not": { "enum": ["relations", "yaml"] } },
          "properties": { "overview": { "properties": { "when": false } } }
        }
      },
      "additionalProperties": false
    },
    "header": {
      "type": "object",
      "description": "Properties an entity page shows beside its title.",
      "properties": {
        "subtitle": { "type": "string", "description": "A property shown under the title, on entity pages and in the catalog." },
        "badges": { "type": "array", "items": { "type": "string" }, "description": "Properties shown as chips beside the title." },
        "link": { "type": "string", "description": "A property with format: uri the page offers to open." }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "pattern": "\\S" },
        "properties": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Property names, each in at most one section."
        }
      },
      "required": ["title"],
      "additionalProperties": false
    }
  }
}
