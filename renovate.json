{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm",
    ":disableRateLimiting",
    "customManagers:githubActionsVersions"
  ],
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "groupName": "github actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ]
    },
    {
      "groupName": "go toolchain",
      "matchDepNames": [
        "go"
      ]
    },
    {
      "groupName": "mise tools",
      "matchDepNames": [
        "go:github.com/air-verse/air",
        "go:mvdan.cc/gofumpt"
      ]
    },
    {
      "description": "The mise version pinned in CI updates with the other dev tools",
      "matchPackageNames": [
        "jdx/mise"
      ],
      "groupName": "mise tools"
    },
    {
      "groupName": "node toolchain",
      "matchDepNames": [
        "node",
        "pnpm",
        "npm:pnpm"
      ]
    },
    {
      "groupName": "vite-plus",
      "matchPackageNames": [
        "vite-plus",
        "@voidzero-dev/vite-plus-core",
        "@voidzero-dev/vite-plus-test",
        "@vitest/coverage-v8"
      ]
    },
    {
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "groupName": "tanstack",
      "matchPackageNames": [
        "@tanstack/**"
      ]
    },
    {
      "groupName": "tailwind",
      "matchPackageNames": [
        "tailwindcss",
        "@tailwindcss/**",
        "tailwind-merge",
        "tw-animate-css"
      ]
    },
    {
      "groupName": "testing library",
      "matchPackageNames": [
        "@testing-library/**",
        "jsdom"
      ]
    },
    {
      "groupName": "fontsource",
      "matchPackageNames": [
        "@fontsource-variable/**"
      ]
    },
    {
      "description": "What ships in the binary gets the deps type, which release-please lists under Dependencies: the Go modules it links",
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "go.mod"
      ],
      "semanticCommitType": "deps",
      "semanticCommitScope": null
    },
    {
      "description": "The Go toolchain the binary is built with ships too",
      "matchDepNames": [
        "go"
      ],
      "semanticCommitType": "deps",
      "semanticCommitScope": null
    },
    {
      "description": "So do the UI's runtime packages, which the binary embeds; build and test tools stay chore",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "semanticCommitType": "deps",
      "semanticCommitScope": null
    },
    {
      "description": "Build-time packages grouped with runtime ones get deps too, since a group with any chore update is committed as chore",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@types/react",
        "@types/react-dom",
        "@tanstack/router-plugin",
        "tailwindcss",
        "@tailwindcss/**"
      ],
      "semanticCommitType": "deps",
      "semanticCommitScope": null
    }
  ],
  "vulnerabilityAlerts": {
    "description": "Security updates are listed under Bug Fixes",
    "semanticCommitType": "fix",
    "semanticCommitScope": "deps"
  }
}
