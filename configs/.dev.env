APP_NAME=goldenportal
APP_VERSION=dev
APP_ENV=development
HTTP_PORT=47200
METRICS_PORT=47221
LOG_LEVEL=INFO
GOFR_TELEMETRY=false

GP_NAME="Acme Portal"
GP_LOGO_URL="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='12' cy='12' r='6' fill='%23d97706'/><path d='M14 26L26 14V26Z' fill='%23d97706' fill-opacity='.6'/></svg>"
GP_FAVICON_URL="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%234f46e5'/><circle cx='12' cy='12' r='6' fill='white'/><path d='M14 26L26 14V26Z' fill='white' fill-opacity='.6'/></svg>"

GP_BASE_URL=http://localhost:47273
GP_OIDC_ISSUER=http://localhost:47800/sso
GP_OIDC_CLIENT_ID=golden-portal-dev
GP_OIDC_CLIENT_SECRET=golden-portal-dev-secret
GP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
GP_SCIM_TOKEN=golden-portal-dev-scim-token-not-for-production
# Lets the session cookie work over plain HTTP in development.
GP_COOKIE_SECURE=false

DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=47433
DB_USER=goldenportal
DB_PASSWORD=goldenportal-local-dev-password
DB_NAME=goldenportal
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNECTION=10
DB_MAX_IDLE_CONNECTION=2

POSTGRES_IMAGE=docker.io/library/postgres:18.4-bookworm
POSTGRES_CONTAINER=goldenportal-postgres

# The ingestion token deps/seed.sql gives the team directory integration,
# which the mock in deps.dev.yaml pushes with.
GP_DEV_TEAM_DIRECTORY_TOKEN=gpi_dev-team-directory-not-for-production

# The mock service registry signs the events it pushes with this, and the
# service registry integration in deps/seed.sql checks them with it.
GP_SECRET_SERVICE_REGISTRY_SIGNING=dev-service-registry-signing-not-for-production

# The http integration in deps/seed.sql sends this to the mock deploy
# tracker, to show how documents reference secrets without holding them.
GP_SECRET_DEPLOY_TRACKER="Bearer dev-deploy-tracker-token-not-for-production"

# The example actions in deps/seed.sql send this to the mock ops API.
GP_SECRET_OPS="Bearer dev-ops-token-not-for-production"
