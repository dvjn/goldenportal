APP_NAME=goldenportal
APP_VERSION=dev
APP_ENV=development
HTTP_PORT=47200
METRICS_PORT=47221
LOG_LEVEL=INFO
GOFR_TELEMETRY=false

GP_NAME="Acme Portal"
GP_LOGO_URL="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%23d97706'/><circle cx='12' cy='12' r='6' fill='white'/><path d='M14 26L26 14V26Z' fill='white' fill-opacity='.6'/></svg>"

DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=47433
DB_USER=goldenportal
DB_PASSWORD=goldenportal-local-dev-password
DB_NAME=goldenportal
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNECTION=10
DB_MAX_IDLE_CONNECTION=2

POSTGRES_IMAGE=docker.io/library/postgres:18.4-bookworm
POSTGRES_CONTAINER=goldenportal-postgres
