APP_NAME=goldport-dev
APP_VERSION=dev
APP_ENV=development
HTTP_PORT=47200
METRICS_PORT=47221
LOG_LEVEL=INFO
GOFR_TELEMETRY=false

GOLDPORT_NAME="Acme Portal"
GOLDPORT_SESSION_MAX_AGE=10h
GOLDPORT_SESSION_IDLE_TIMEOUT=45m

DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=47433
DB_USER=goldport
DB_PASSWORD=goldport-local-dev-password
DB_NAME=goldport
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNECTION=10
DB_MAX_IDLE_CONNECTION=2

POSTGRES_IMAGE=postgres:18.4-bookworm
POSTGRES_CONTAINER=goldport-postgres
