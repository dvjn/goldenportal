# configs/.dev.local.env, if present, overrides these for this machine, for
# example to serve the portal and sign-in at addresses other than localhost.
APP_NAME=goldenportal
APP_VERSION=dev
APP_ENV=development
HTTP_PORT=47200
METRICS_PORT=47221
LOG_LEVEL=INFO
# When rows older than their blueprint's retention keeps them are deleted,
# a cron expression; daily at 04:17 unless set.
# RETENTION_SCHEDULE="17 4 * * *"
# When every scorecard is evaluated in full, a cron expression; hourly
# unless set. The server also evaluates them as it starts; publishing a
# scorecard, or the blueprint it scores, evaluates it straight away, and
# Evaluate Now does on demand. An invalid schedule stops the server.
# SCORECARD_EVALUATION_SCHEDULE="0 * * * *"
# Blueprints with at least this many entities get indexes for what published
# configuration sorts and filters them by, up to a number per blueprint and
# in all; a cap of 0 turns them off and drops those built. They're reconciled
# after each publish, as the server starts, and on a schedule, a cron
# expression; hourly unless set.
# ENTITY_INDEX_MIN_ROWS=50000
# ENTITY_INDEX_MAX_PER_BLUEPRINT=8
# ENTITY_INDEX_MAX=64
# ENTITY_INDEX_SCHEDULE="41 * * * *"
GOFR_TELEMETRY=false

GP_NAME="Acme Portal"
GP_LOGO_URL="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='12' cy='12' r='6' fill='%23d97706'/><path d='M14 26L26 14V26Z' fill='%23d97706' fill-opacity='.6'/></svg>"
GP_FAVICON_URL="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%234f46e5'/><circle cx='12' cy='12' r='6' fill='white'/><path d='M14 26L26 14V26Z' fill='white' fill-opacity='.6'/></svg>"

GP_BASE_URL=http://localhost:47273
GP_OIDC_ISSUER=http://localhost:47800/sso
GP_OIDC_CLIENT_ID=golden-portal-dev
GP_OIDC_CLIENT_SECRET=golden-portal-dev-secret
GP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
GP_SCIM_TOKEN=golden-portal-dev-scim-token-not-for-production
# Lets the session cookie work over plain HTTP in development.
GP_COOKIE_SECURE=false

DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=47433
DB_USER=goldenportal
DB_PASSWORD=goldenportal-local-dev-password
DB_NAME=goldenportal
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNECTION=10
DB_MAX_IDLE_CONNECTION=2

POSTGRES_IMAGE=docker.io/library/postgres:18.4-bookworm
POSTGRES_CONTAINER=goldenportal-postgres

# Traces go to Jaeger in deps.dev.yaml, whose UI is at JAEGER_UI_PORT.
TRACE_EXPORTER=otlp
TRACER_URL=localhost:47317
TRACER_RATIO=1
JAEGER_IMAGE=docker.io/jaegertracing/jaeger:2.22.0
JAEGER_CONTAINER=goldenportal-jaeger
JAEGER_UI_PORT=47686
JAEGER_OTLP_PORT=47317

# The ingestion token deps/seed.sql gives the team directory connection,
# which the mock in deps.dev.yaml pushes with.
GP_DEV_TEAM_DIRECTORY_TOKEN=gpi_dev-team-directory-not-for-production

# The mock service registry signs the events it pushes with this, and the
# service registry connection in deps/seed.sql checks them with it.
GP_SECRET_SERVICE_REGISTRY_SIGNING=dev-service-registry-signing-not-for-production

# The http connection in deps/seed.sql sends this to the mock deploy
# tracker, to show how documents reference secrets without holding them.
GP_SECRET_DEPLOY_TRACKER="Bearer dev-deploy-tracker-token-not-for-production"

# The example actions in deps/seed.sql send this to the mock ops API.
GP_SECRET_OPS="Bearer dev-ops-token-not-for-production"

# The mock GitLab in deps.dev.yaml takes this access token, which the gitlab
# connection in deps/seed.sql reads with.
GP_SECRET_GITLAB_TOKEN=glpat-dev-not-for-production

# Each connection's webhook secret is derived from this, such as the one
# the gitlab connection sets up on the mock GitLab's projects, which sends
# it with each event.
GP_WEBHOOK_KEY=dev-webhook-key-not-for-production
